# Copy to .env (never commit it) and load it with `set -a; . ./.env; set +a`.
# Every variable is described in README.md.

# --- Local run without a WhatsApp account or OpenAI key -----------------------
# Fake bridge: canned chats, sends are acknowledged then marked delivered/read.
# Set to qr to show a pairing QR code for five seconds before connecting.
WA_FAKE_BRIDGE=true
# Fake text AI: translations come back as "[Spanish → English] original text".
WA_FAKE_AI=true

WA_WEB=true
WA_HOST=127.0.0.1
WA_PORT=3000
WA_ALLOW_LOCAL_NO_AUTH=true
# Keep fake runs away from a real session.
WA_DATA_DIR=./.data/fake
# Skip the build.rs bridge build when only Rust changed.
SKIP_GO_BUILD=1
# Built with: npx nx build wa-bridge (or: cd apps/wa-bridge && go build -o wa-bridge .)
WA_BRIDGE_PATH=./apps/wa-bridge/wa-bridge

# --- Real run -----------------------------------------------------------------
# Remove the two WA_FAKE_* lines above and set:
# OPENAI_API_KEY=
# WA_PASSWORD=          required whenever WA_HOST is not loopback
# WA_DEFAULT_LANGUAGE=English
# WA_VERBOSE=true
