{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "wa-bridge",
  "projectType": "application",
  "targets": {
    "format-check": {
      "command": "unformatted=\"$(gofmt -l .)\"; if [ -n \"$unformatted\" ]; then echo 'error: run gofmt -w on these files:'; echo \"$unformatted\"; exit 1; fi",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["go"]
    },
    "lint": {
      "command": "go vet ./...",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["go"]
    },
    "test": {
      "command": "go test ./...",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["go"]
    },
    "build": {
      "command": "CGO_ENABLED=1 go build -o wa-bridge .",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["go"],
      "outputs": ["{projectRoot}/wa-bridge"]
    }
  }
}
